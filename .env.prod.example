# === Copier ce fichier en .env.prod à la racine du projet, puis remplir les CHANGE_MOI ===

# === Général ===
ENVIRONMENT=production
DEBUG=false
APP_NAME=MTI Backend API

# === Base de données (nom de service Docker "postgres", pas 127.0.0.1) ===
POSTGRES_USER=mti_user
POSTGRES_PASSWORD=CHANGE_MOI_mot_de_passe_fort
POSTGRES_DB=mti_db
DATABASE_URL=postgresql+psycopg://mti_user:CHANGE_MOI_mot_de_passe_fort@postgres:5432/mti_db

# === Auth / JWT ===
# Générer avec : openssl rand -hex 32
SECRET_KEY=CHANGE_MOI_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === CORS (uniquement le vrai domaine en prod, pas de localhost) ===
CORS_ORIGINS=["https://mtishop.tn","https://www.mtishop.tn"]

# === Uploads (chemin relatif au WORKDIR /app du conteneur backend) ===
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# === SMTP (compte mail pro cPanel existant) ===
SMTP_HOST=mail.mtishop.tn
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USER=contact@mtishop.tn
SMTP_PASSWORD=CHANGE_MOI_mot_de_passe_du_compte_mail
SMTP_FROM_EMAIL=contact@mtishop.tn
SMTP_FROM_NAME=MTI

# === Liens dans les emails (verify-email, reset-password) ===
FRONTEND_BASE_URL=https://mtishop.tn

# === Build frontend (passé comme build arg dans docker-compose.prod.yml) ===
VITE_API_URL=/api
