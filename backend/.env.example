# Copy this file to .env and fill in real values before running the app.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://mti_user:mti_password@localhost:5432/mti_db

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list is parsed automatically by pydantic-settings
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100
SMTP_HOST=mail.mtishop.tn
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USER=contact@mtishop.tn
SMTP_PASSWORD=<le mot de passe du compte mail>
SMTP_FROM_EMAIL=contact@mtishop.tn